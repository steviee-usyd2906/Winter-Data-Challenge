        "#quarto-code-tools-menu + .dropdown-menu .dropdown-item,\n",
        ".code-tools-button + .dropdown-menu .dropdown-item,\n",
        "ul.dropdown-menu[aria-labelledby*=\"code-tools\"] .dropdown-item,\n",
        ".dropdown-menu.show .dropdown-item {\n",
