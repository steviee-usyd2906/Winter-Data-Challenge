      "source": [
        "---\n",
        "title: \"Fire, Heat, and the Wildlife Recovery Gap in Australia\"\n",
        "subtitle: \"A complete pipeline: from raw fire-history shapefiles to an event-level test of whether post-fire heat widens the gap between vegetation greening and wildlife recovery\"\n",
        "author:\n",
        "  - name: \"[Team members + SID]\"\n",
        "    affiliation: \"The University of Sydney - Winter Data Analysis Challenge\"\n",
        "date: today\n",
        "format:\n",
        "  html:\n",
        "    toc: true\n",
        "    toc-depth: 3\n",
        "    toc-location: left\n",
        "    number-sections: true\n",
        "    theme: cosmo\n",
        "    code-fold: true\n",
        "    code-tools: true\n",
        "    fig-align: center\n",
        "    fig-cap-location: bottom\n",
        "    fig-width: 8\n",
        "    fig-height: 5\n",
        "    embed-resources: true\n",
        "editor:\n",
        "  markdown:\n",
        "    wrap: 72\n",
        "execute:\n",
        "  warning: false\n",
        "  message: false\n",
        "jupyter: python3\n",
        "---\n",
        "\n",
        "```{=html}\n",
        "<style>\n",
