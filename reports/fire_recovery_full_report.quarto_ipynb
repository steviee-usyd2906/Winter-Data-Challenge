        "\n",
        "fig.suptitle(f\"Distributions of heat exposure, vegetation recovery, and the recovery gap ({len(events)} major fire events)\", y=1.04)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "bb346c1f",
