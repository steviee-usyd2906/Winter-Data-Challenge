        "  html:\n",
        "    toc: true\n",
        "    toc-depth: 3\n",
        "    toc-location: left\n",
        "    number-sections: true\n",
        "    theme: cosmo\n",
        "    code-fold: true\n",
        "    code-tools: true\n",
